# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
# Where the React app runs. Used for CORS and OAuth redirects back to the UI.
FRONTEND_URL=http://localhost:5173
# Public URL of this backend. Used to build default OAuth callback URLs.
BACKEND_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
MONGO_URI=your_mongodb_connection_string

# ---------------------------------------------------------------------------
# Auth (required) - long random string used to sign JWTs
# ---------------------------------------------------------------------------
JWT_SECRET=your_long_random_jwt_secret

# ---------------------------------------------------------------------------
# AI provider
# Set GEMINI_API_KEY for real AI-generated questions, scoring and feedback.
# Without it the app still runs, but uses a clearly-labelled non-AI fallback.
# The *_MODEL lines are optional overrides.
# Key: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Optional secondary provider, used only if Gemini is unset or fails.
# ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------------------------------------------------------------------------
# Email / OTP (required for signup)
# Signup emails a 6-digit verification code. Without these, signup returns a
# clear configuration error rather than pretending the email was sent.
# For Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) - never your normal password.
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_app_password
EMAIL_FROM=InterviewMate <your_email@gmail.com>

# ---------------------------------------------------------------------------
# Google OAuth (optional - the Google button is disabled without it)
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must match GOOGLE_CALLBACK_URL exactly.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------------------------------------------------------------------------
# GitHub OAuth (optional - the GitHub button is disabled without it)
# Settings: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL must match GITHUB_CALLBACK_URL exactly.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
