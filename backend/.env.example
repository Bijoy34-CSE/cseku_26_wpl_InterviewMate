# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env file.

# --- Required ---------------------------------------------------------
MONGO_URI=
JWT_SECRET=

# --- Server / URLs ----------------------------------------------------
PORT=5000
NODE_ENV=development
# Where the React app is served from (CORS + OAuth redirects).
FRONTEND_URL=http://localhost:5173
# This API's public URL (used for default OAuth callbacks).
BACKEND_URL=http://localhost:5000
# Extra browser/app origins allowed to call the API, comma-separated, e.g.
#   https://localhost,capacitor://localhost,app://interviewmate
CORS_ALLOWED_ORIGINS=
# Set to 1 when running behind one reverse proxy / load balancer.
TRUST_PROXY=

# --- AI ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# --- Email (signup / password-reset OTP) ------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- OAuth (see oauth-payment.env.example for callback URLs) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# --- Admin & Premium --------------------------------------------------
ADMIN_EMAILS=
PREMIUM_MONTHLY_PRICE_BDT=499
PREMIUM_YEARLY_PRICE_BDT=2999
