# Copy to frontend/.env (or .env.production) before building.
#
# Public URL of the backend API, WITHOUT a trailing /api and without a trailing slash.
# - Not needed for `npm run dev` (it uses http://localhost:5000).
# - REQUIRED for production web builds on a different domain than the API,
#   and for desktop (Electron) / mobile (Capacitor) builds.
VITE_API_ORIGIN=http://localhost:5000
